# Application
FLASK_ENV=development
SECRET_KEY=dev-secret-key-ONLY-for-local

# AI providers (required)
GROQ_API_KEY=
GEMINI_API_KEY=

# Firebase Auth (required for signup/login)
FIREBASE_API_KEY=

# Database (optional - defaults to SQLite in instance/)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Reddit API for Explore (falls back to Hacker News when unset)
# Create a "script" app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Optional: override the default AI models
# GROQ_CHAT_MODEL=qwen/qwen3.8-27b
# GROQ_FAST_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
